{
  "manifest_version": 3,
  "name": "PageTrawl",
  "version": "1.28.0",
  "description": "Açık sayfadaki fotoğraf ve videoları listeler, filtreleyip toplu indirir.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "webRequest",
    "nativeMessaging",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PageTrawl",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "probe.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
